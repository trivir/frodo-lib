{
  "compilerOptions": {
    "noEmit": true,

    "module": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    "types": ["node"],
    "lib": ["es2023"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    // I want to turn this on, but it's a lot
    "useUnknownInCatchVariables": false
  },
  "typedocOptions": {
    "name": "Frodo Library",
    "entryPoints": ["./src"],
    "entryPointStrategy": "resolve",
    "out": "./docs",
    "readme": ".github/README.md",
    "excludeExternals": true,
    "includeVersion": true,
    "disableSources": false,
    "hideGenerator": true,
    "searchInComments": true,
    "navigationLinks": {
      "Project Home": "https://github.com/rockcarver/frodo-lib"
    },
    // plugins and params
    "plugin": ["typedoc-plugin-missing-exports"],
    "internalModule": "Reference"
  }
}
